cabal-version: 3.0
name:          hmssql-example-bulk-copy
version:       0.1.0
synopsis:      Copy a table between two databases with the TDS bulk load
license:       BSD-3-Clause
author:        Joey Adams
build-type:    Simple
data-files:    sql/demo-source.sql, sql/demo-target.sql

common shared
  default-language:   GHC2021
  default-extensions: DerivingStrategies, DuplicateRecordFields, LambdaCase, MultiWayIf, OverloadedRecordDot,
                      OverloadedStrings, RecordWildCards
  ghc-options:        -Wall -Wno-name-shadowing
  build-depends:      base >= 4.18 && < 5, hmssql, hmssql-example-shop-db, containers, streaming, text

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules: Copy.Check, Copy.Run
  other-modules:   Paths_hmssql_example_bulk_copy
  autogen-modules: Paths_hmssql_example_bulk_copy

executable hmssql-example-bulk-copy
  import:          shared
  hs-source-dirs:  app
  main-is:         Main.hs
  other-modules:   Paths_hmssql_example_bulk_copy
  autogen-modules: Paths_hmssql_example_bulk_copy
  ghc-options:     -threaded
  build-depends:   hmssql-example-bulk-copy, bytestring, optparse-applicative, time
