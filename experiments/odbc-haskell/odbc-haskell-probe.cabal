cabal-version: 3.0
name: odbc-haskell-probe
version: 0.1.0.0
build-type: Simple

executable odbc-haskell-probe
  main-is: Main.hs
  default-language: Haskell2010
  ghc-options: -Wall -O2 -threaded -rtsopts
  build-depends:
    base >=4.20 && <5, odbc ==0.3.0, text, bytestring, time,
    deepseq, async
